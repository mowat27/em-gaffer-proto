{
  "name": "c4-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "C4 Studio: local app for viewing, editing, branching and chatting about C4 models stored as Structurizr DSL.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node bin/c4-studio.mjs serve",
    "cli": "node bin/c4-studio.mjs",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.94",
    "@ai-sdk/fireworks": "3.0.85",
    "@ai-sdk/react": "4.0.163",
    "@dagrejs/dagre": "3.1.3",
    "@hono/node-server": "2.1.5",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@pw/ui": "npm:@precision-weave/ui@0.5.1",
    "@xyflow/react": "12.12.0",
    "ai": "7.0.159",
    "chokidar": "6.0.0",
    "gray-matter": "4.0.3",
    "hono": "4.13.14",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
