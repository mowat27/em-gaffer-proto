# List available targets
@default:
    just --list

# Start everything with hot reload: Supabase, env files, API (tsx watch) and web (vite). Ctrl+c stops API and web.
up: install db-start env
    #!/usr/bin/env bash
    set -e
    node scripts/check-ports.mjs
    foreman start &
    echo $! > .foreman.pid
    trap 'kill -INT $(cat .foreman.pid) 2>/dev/null; wait' INT TERM
    wait

# Stop API and web started by `just up` from another terminal (Supabase keeps running; `just db-stop` stops it)
down:
    #!/usr/bin/env bash
    # Only this app's processes: the foreman started by `just up`, then anything still on this app's ports.
    [ -f .foreman.pid ] && kill -INT "$(cat .foreman.pid)" 2>/dev/null; rm -f .foreman.pid
    sleep 2
    for port in __API_PORT__ __WEB_PORT__; do lsof -ti "tcp:$port" -sTCP:LISTEN | xargs kill 2>/dev/null; done
    pgrep -f "tsx watch .*server.ts" | while read pid; do [ "$(lsof -a -p "$pid" -d cwd -Fn | sed -n 's/^n//p')" = "$PWD" ] && kill "$pid"; done
    exit 0

# Install dependencies when missing
install:
    [ -d node_modules ] || npm install
    [ -d web/node_modules ] || npm --prefix web install

# Start the local Supabase stack (ports in supabase/config.toml)
db-start:
    supabase status >/dev/null 2>&1 || supabase start

# Stop the local Supabase stack
db-stop:
    supabase stop

# Write .env and web/.env from the running Supabase stack and skeleton.json
env:
    node scripts/write-env.mjs

# Apply database migrations with Flyway (the API also does this on every dev restart)
db-migrate:
    npm run flyway:migrate

# Create a user to sign in with: just user me@example.com secret123
user email password:
    npm run create-user -- {{email}} {{password}}

# Backend tests (Docker) and front end build + lint
check:
    npm test
    npm --prefix web run build
    npm --prefix web run lint
