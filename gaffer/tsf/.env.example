# Copy this file to tsf/.env and fill it in. Variables already set in the environment win over this file.

# Model provider keys (read from the environment only). On a vault-routed VM the value is the placeholder
# agent-vault; the proxy swaps in the real key.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Where the server listens. A VM behind the exe.dev proxy needs TSF_HOST=0.0.0.0 (port 8000 is forwarded to
# https://<vm>.exe.xyz) and TSF_ALLOWED_HOSTS=<vm>.exe.xyz so the request guard accepts that host name.
TSF_HOST=127.0.0.1
TSF_PORT=8000
# TSF_ALLOWED_HOSTS=<vm>.exe.xyz

# Run on the built-in scripted model instead of a provider (no key needed).
# TSF_MODEL_PROVIDER=faux
