# C4 Studio provider keys. Copy to .env (gitignored) and fill in the ones you use.
# Use the placeholder "agent-vault" for a key when the Agent Vault proxy is in use.

# Chat provider "openrouter" (the default)
OPENROUTER_API_KEY=

# Chat provider "fireworks"
FIREWORKS_API_KEY=

# Chat provider "anthropic"
ANTHROPIC_API_KEY=

# Server port (overrides "port" in config.json)
# C4_STUDIO_PORT=47145
