{
  "name": "gaffer-builder",
  "private": true,
  "type": "module",
  "description": "The builder: build server, pi agent, verifier and dev loop. Typecheck and tests only; the code runs on Node 24 type stripping.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"test/*.test.ts\" \"test/unit/**/*.test.ts\"",
    "record-dispatches": "node test/baseline/record-dispatches.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "24.19.2",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "handlebars": "4.7.10",
    "yaml": "2.9.0"
  }
}
