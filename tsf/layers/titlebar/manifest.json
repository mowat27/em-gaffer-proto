{
  "name": "titlebar",
  "kind": "harness",
  "title": "Title bar controls",
  "description": "Model and thinking-effort dropdowns in the global title bar.",
  "version": "0.1.0",
  "origin": "local",
  "enabledByDefault": true,
  "env": [],
  "vaultHosts": [],
  "ui": {
    "settingsPanels": [],
    "widgets": [
      {
        "id": "titlebar.model",
        "title": "Model",
        "description": "Pick the model the agent uses.",
        "navbars": [
          "global"
        ],
        "defaultOptions": {},
        "defaultPlacements": [
          {
            "navbar": "global",
            "slot": "right"
          }
        ],
        "control": {
          "kind": "select",
          "label": "Model",
          "query": "core:settings.get",
          "field": "model.modelId",
          "optionsQuery": {
            "query": "core:models.list",
            "valueField": "id",
            "labelField": "name",
            "sortBy": "label"
          },
          "action": "core:model.set",
          "actionInput": {
            "modelId": "$value"
          },
          "capability": "model.set"
        }
      },
      {
        "id": "titlebar.effort",
        "title": "Effort",
        "description": "The thinking level the agent reasons with.",
        "navbars": [
          "global"
        ],
        "defaultOptions": {},
        "defaultPlacements": [
          {
            "navbar": "global",
            "slot": "right"
          }
        ],
        "control": {
          "kind": "select",
          "label": "Effort",
          "query": "core:settings.get",
          "field": "thinkingLevel",
          "options": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "action": "core:thinking.set",
          "actionInput": {
            "level": "$value"
          },
          "capability": "thinking.set"
        }
      }
    ],
    "hotkeys": []
  },
  "capabilities": []
}
